---
import { Image } from "astro:assets";
import { nav, shop } from "../data/site";
import logo from "../assets/favicon.png";
---

<div class="brand">
	<a class="mark" href="#top" aria-label={shop.name}>
		<Image src={logo} alt={shop.name} widths={[160, 240]} sizes="84px" />
	</a>
	<a class="ig" href={shop.instagram} target="_blank" rel="noopener noreferrer">
		<span class="visually-hidden">Instagram @{shop.instagramHandle}</span>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				fill="currentColor"
				d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 1.8H7A2.2 2.2 0 0 0 4.8 7v10A2.2 2.2 0 0 0 7 19.2h10a2.2 2.2 0 0 0 2.2-2.2V7A2.2 2.2 0 0 0 17 4.8zM12 8.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8zM17.35 6.4a.95.95 0 1 1-.95.95.95.95 0 0 1 .95-.95z"
			></path>
		</svg>
	</a>
</div>

<nav class="edge" aria-label="ページ内">
	{
		nav.map((item) => (
			<a href={item.href}>{item.label}</a>
		))
	}
</nav>

<button class="burger" type="button" data-burger aria-expanded="false" aria-controls="site-menu">
	<span class="burger-lines" aria-hidden="true">
		<span></span>
		<span></span>
	</span>
	<span class="visually-hidden">メニュー</span>
</button>

<div class="overlay" id="site-menu" data-overlay>
	<nav aria-label="ページ内">
		{
			nav.map((item) => (
				<a href={item.href}>{item.label}</a>
			))
		}
	</nav>
</div>
