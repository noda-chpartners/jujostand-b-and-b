---
import { Image } from "astro:assets";
import table from "../assets/LINE_ALBUM_20261015_261019_4.jpg";
import yukke from "../assets/LINE_ALBUM_20261015_261019_5.jpg";
import uni from "../assets/LINE_ALBUM_20261015_261019_1.jpg";
---

<section class="feature" aria-label="料理">
	<figure class="feature-wide">
		<Image
			src={table}
			alt="卓の料理とドリンク"
			widths={[800, 1400, 2000]}
			sizes="100vw"
		/>
	</figure>
	<div class="feature-pair">
		<figure class="feature-yukke">
			<Image
				src={yukke}
				alt="山かけユッケ"
				widths={[480, 900, 1400]}
				sizes="(max-width: 1024px) 100vw, 56vw"
			/>
		</figure>
		<figure class="feature-uni">
			<Image
				src={uni}
				alt="ウニの一品"
				widths={[480, 900, 1400]}
				sizes="(max-width: 1024px) 100vw, 44vw"
			/>
		</figure>
	</div>
</section>
