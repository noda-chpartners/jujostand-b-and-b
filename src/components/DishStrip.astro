---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import line3 from "../assets/LINE_ALBUM_20261015_261019_3.jpg";
import line23 from "../assets/LINE_ALBUM_20261015_261019_23.jpg";
import line24 from "../assets/LINE_ALBUM_20261015_261019_24.jpg";
import line26 from "../assets/LINE_ALBUM_20261015_261019_26.jpg";
import line27 from "../assets/LINE_ALBUM_20261015_261019_27.jpg";
import line28 from "../assets/LINE_ALBUM_20261015_261019_28.jpg";
import rolls from "../assets/S__24870947_0.jpg";
import chicken from "../assets/S__24870940_0.jpg";
import salad from "../assets/S__24870941_0.jpg";
import tartar from "../assets/S__24870942_0.jpg";
import salsa from "../assets/S__24870943_0.jpg";
import potato from "../assets/S__24870944_0.jpg";
import tomato from "../assets/S__24870945_0.jpg";

const dishes: { src: ImageMetadata; alt: string }[] = [
	{ src: line3, alt: "おつまみ三種" },
	{ src: rolls, alt: "巻き寿司" },
	{ src: chicken, alt: "よだれ鶏" },
	{ src: salad, alt: "サラダ" },
	{ src: tartar, alt: "タルタルソースの揚げ物" },
	{ src: salsa, alt: "サルサ付きの揚げ物" },
	{ src: potato, alt: "ポテト" },
	{ src: tomato, alt: "ガリトマト" },
	{ src: line23, alt: "レバーの炒め" },
	{ src: line24, alt: "とりわさ" },
	{ src: line26, alt: "ネギトロ" },
	{ src: line27, alt: "鉄板ステーキ" },
	{ src: line28, alt: "ネギ塩レバー" },
];
---

<ul class="dish-strip">
	{
		dishes.map((item) => (
			<li>
				<Image
					src={item.src}
					alt={item.alt}
					widths={[320, 520, 720]}
					sizes="(max-width: 1024px) 70vw, 16rem"
				/>
			</li>
		))
	}
</ul>
