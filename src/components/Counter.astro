---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { menu, type MenuPhoto } from "../data/site";
import nikusushi from "../assets/LINE_ALBUM_20261015_261019_9.jpg";
import sashimi from "../assets/1792472889.png";
import karamen from "../assets/S__24870946_0.jpg";
import harami from "../assets/LINE_ALBUM_20261015_261019_10.jpg";
import kaki from "../assets/1792459059.png";

const photos: Record<MenuPhoto, ImageMetadata> = {
	nikusushi,
	sashimi,
	karamen,
	harami,
	kaki,
};

const alts: Record<MenuPhoto, string> = {
	nikusushi: "肉寿司",
	sashimi: "お任せお刺身盛り合わせ",
	karamen: "辛麺",
	harami: "ハラミステーキ",
	kaki: "生牡蠣",
};

const focus: Record<MenuPhoto, string> = {
	nikusushi: "center",
	sashimi: "center 42%",
	karamen: "center 58%",
	harami: "center",
	kaki: "center 60%",
};

const tight: Record<MenuPhoto, boolean> = {
	nikusushi: false,
	sashimi: false,
	karamen: true,
	harami: false,
	kaki: true,
};
---

<section class="counter" id="dishes" aria-labelledby="dishes-title">
	<h2 id="dishes-title" class="visually-hidden">看板メニュー</h2>
	<ul class="counter-list">
		{
			menu.map((item) => (
				<li class="counter-row">
					{item.photo ? (
						<span class:list={["plate-frame", tight[item.photo] && "is-tight"]} data-plate>
							<Image
								class="plate"
								src={photos[item.photo]}
								alt={alts[item.photo]}
								widths={[160, 280, 400]}
								sizes="(max-width: 480px) 52px, (max-width: 1024px) 72px, 124px"
								style={`object-position: ${focus[item.photo]}`}
							/>
						</span>
					) : (
						<span class="plate-gap" aria-hidden="true"></span>
					)}
					<p class="counter-name">{item.name}</p>
					<p class="counter-price">{item.price}</p>
				</li>
			))
		}
	</ul>
</section>
