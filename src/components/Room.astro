---
import { Image } from "astro:assets";
import { copy, shop } from "../data/site";
import room from "../assets/1792472879.png";

const mapQuery = encodeURIComponent(shop.mapQuery);
const mapEmbed = `https://maps.google.com/maps?q=${mapQuery}&hl=ja&z=16&output=embed`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section class="room" id="room" aria-labelledby="room-title">
	<h2 id="room-title" class="visually-hidden">店内</h2>
	<div class="room-copy">
		<div class="room-note">
			<p class="room-stat">{shop.seats}</p>
			<p class="room-stat">{shop.privateBooking}</p>
			<p class="room-welcome">{copy.welcome}</p>
		</div>
		<div class="room-place" id="place">
			<p class="slip-address">
				<span class="slip-postal">〒{shop.postalCode}</span>
				{shop.addressLines[0]}<br />
				{shop.addressLines[1]}
			</p>
			<ul class="slip-lines">
				<li>{shop.station}</li>
				<li>電話番号：<a href={`tel:${shop.phone.replace(/-/g, "")}`}>{shop.phone}</a></li>
				<li>
					{shop.hours}
					<span>（{shop.hoursNote}）</span>
				</li>
				<li>{shop.closed}</li>
				<li>{shop.payment}</li>
			</ul>
		</div>
	</div>
	<Image
		class="room-photo"
		src={room}
		alt="壁にメニューが並ぶ店内。丸いハイテーブルとテレビ。"
		widths={[480, 720, 960]}
		sizes="(max-width: 680px) 92vw, 520px"
	/>
	<div class="map-band">
		<iframe title="十条STAND B&Bの地図" src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
		<a class="map-open" href={mapHref} target="_blank" rel="noopener noreferrer">地図を開く</a>
	</div>
</section>
