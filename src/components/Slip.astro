---
import { Image } from "astro:assets";
import { siInstagram } from "simple-icons";
import { shop } from "../data/site";
import logo from "../assets/1792472895.png";
---

<section class="slip" aria-label="店名">
	<footer class="colophon">
		<div class="colophon-brand">
			<a class="colophon-mark" href="#top">
				<Image src={logo} alt="" widths={[96, 160]} sizes="54px" format="png" />
			</a>
			<p class="colophon-name">{shop.name}</p>
		</div>
		<a class="colophon-ig" href={shop.instagram} target="_blank" rel="noopener noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path fill={`#${siInstagram.hex}`} d={siInstagram.path}></path>
			</svg>
			<span class="visually-hidden">Instagram @{shop.instagramHandle}</span>
		</a>
	</footer>
</section>
